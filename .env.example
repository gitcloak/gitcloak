# GitHub App Configuration
# Create a GitHub App at: https://github.com/settings/apps
# See https://docs.github.com/en/apps/creating-github-apps for setup guidance.
# This allows users to select specific repositories during installation

# App ID (found at top of your GitHub App settings page)
GITHUB_APP_ID=your_app_id_here

# OAuth credentials (found in GitHub App settings)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Private key (download from GitHub App settings, save as gitcloak-app.private-key.pem)
GITHUB_PRIVATE_KEY_PATH=./gitcloak-app.private-key.pem

# GitHub App name (for installation links)
NEXT_PUBLIC_GITHUB_APP_NAME=gitcloak

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Application URL
AUTH_URL=http://localhost:3000

# Storage backend: "git" (default, GitHub) or "mock" (in-memory). See
# `src/lib/backends`.
#
# Leave unset (or "git") everywhere except the automated test suite. The mock
# backend is reserved for Playwright, which sets `FILE_BACKEND=mock` itself.
# It is never selected automatically. Previews therefore use the real GitHub
# backend, so a preview needs the GitHub/Auth variables in the Preview scope
# and its callback URL registered on the GitHub App.
# FILE_BACKEND=git

    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.9",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"

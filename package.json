{
  "name": "gitcloak",
  "version": "0.1.0",
  "description": "Secure, encrypted file editing for GitHub repositories with client-side age encryption",
  "author": "GitCloak Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/gitcloak.git"
  },
  "keywords": [
    "encryption",
    "age",
    "github",
    "security",
    "privacy",
    "nextjs",
    "end-to-end-encryption"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "@octokit/auth-app": "^8.1.2",
    "@octokit/rest": "^22.0.1",
    "age-encryption": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}

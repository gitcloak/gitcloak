{
  "name": "gitcloak",
  "version": "0.1.0",
  "description": "Secure, encrypted file editing for GitHub repositories with client-side age encryption",
  "author": "GitCloak Contributors",
  "license": "MIT",
  "homepage": "https://gitcloak-pearl.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitcloak/gitcloak.git"
  },
  "bugs": {
    "url": "https://github.com/gitcloak/gitcloak/issues"
  },
  "keywords": [
    "encryption",
    "age",
    "github",
    "security",
    "privacy",
    "nextjs",
    "end-to-end-encryption"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
